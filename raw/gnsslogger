 */
public class GnssLogger implements GnssListener {

    private static final String TAG = "GnssLogger";
    private static final String FILE_PREFIX = "gnss_log";

    private static final String ERROR_WRITING_FILE = "Problem writing to file.";
    private static final String WARNING_NOYIMPLEMENTED = "Not Implemented";
    private static int gMeasCnt = 0;

    private final Context mContext;
    private String mStrBuff = "";

    private BufferedWriter mRawFileWriter;
    private BufferedWriter mPosFileWriter;
    private BufferedWriter mNLPFileWriter;
    private BufferedWriter mNMAFileWriter;

    private File mRawFile;
    private File mPosFile;
    private File mNLPFile;
    private File mNMAFile;

    private int mRawOpenFile = 0;
    private int mPosOpenFile = 0;
    private int mNLPOpenFile = 0;
    private int mNMAOpenFile = 0;
    private boolean isWriteLog = true;
    private boolean isWritetoFile = true;
    private ReentrantLock reentrantLock = new ReentrantLock();

    public GnssLogger(Context context) {
        this.mContext = context;
    }

    /**
     * Start a new file logging process.
     */
    public void startNewLog() {
        /* Initial Log File Contents */
        if (isWritetoFile) {
            mRawOpenFile = initLogFileContents();
        }
        if (isWritetoFile) {
            mPosOpenFile = initPosFileContents();
        }
        if (isWritetoFile) {
            mNLPOpenFile = initNLPFileContents();
        }
        if (isWritetoFile) {
            mNMAOpenFile = initNMAFileContents();
        }
    }

    @Override
    public void onProviderEnabled(String provider) {
        logWarn(provider + WARNING_NOYIMPLEMENTED);
    }

    @Override
    public void onProviderDisabled(String provider) {
        logWarn(provider + WARNING_NOYIMPLEMENTED);
    }

    @Override
    public void onLocationChanged(Location location) {
        if (location.getProvider().equals(LocationManager.GPS_PROVIDER)) {
            String locationStream = "";
            if (isWriteLog) {
                locationStream = String.format(Locale.US,
                        "Fix,%s,%f,%f,%f,%f,%f,%f,%d,%d%n",
                        location.getProvider(),
                        location.getLatitude(),
                        location.getLongitude(),
                        location.getAltitude(),
                        location.getSpeed(),
                        location.getAccuracy(),
                        location.getBearing(),
                        System.currentTimeMillis(),
                        location.getTime());
            }
            if (mPosFileWriter != null && mPosOpenFile != 0) {
                try {
                    mPosFileWriter.write(locationStream);
                    mPosFileWriter.newLine();
                    mPosFileWriter.flush();
                } catch (IOException e) {
                    logException(ERROR_WRITING_FILE, e);
                }
            }
            reentrantLock.lock();
        }
        if (location.getProvider().equals(LocationManager.NETWORK_PROVIDER)) {
            String locationStream = "";

            if (isWriteLog) {
                locationStream =
                        String.format(Locale.US,
                                "NLP,%s,%f,%f,%f,%f,%f,%f,%d,%d%n",
                                location.getProvider(),
                                location.getLatitude(),
                                location.getLongitude(),
                                location.getAltitude(),
                                location.getSpeed(),
                                location.getAccuracy(),
                                location.getBearing(),
                                System.currentTimeMillis(),
                                location.getTime());
            }
            if (mNLPFileWriter != null && mNLPOpenFile != 0) {
                try {
                    mNLPFileWriter.write(locationStream);
                    mNLPFileWriter.newLine();
                    mNLPFileWriter.flush();
                } catch (IOException e) {
                    logException(ERROR_WRITING_FILE, e);
                }
            }
            reentrantLock.lock();
        }
    }

    @Override
    public void onLocationStatusChanged(String provider, int status, Bundle extras) {
        logWarn(provider + WARNING_NOYIMPLEMENTED);
    }

    @RequiresApi(api = Build.VERSION_CODES.N)
    @Override
    public void onGnssMeasurementsReceived(GnssMeasurementsEvent event) {
        gMeasCnt = event.getMeasurements().size();

        GnssClock gnssClock = event.getClock();
        if (mRawFileWriter != null) {
            for (GnssMeasurement measurement : event.getMeasurements()) {
                updGnssMeasStr(gnssClock, measurement);
                try {
                    if (writeGnssMeasurementToFile(gnssClock, measurement) == 0) {
                        logError(ERROR_WRITING_FILE);
                    }
                } catch (IOException e) {
                    logException(ERROR_WRITING_FILE, e);
                }
            }
        }
        int i = 0;
        int mMeasCnt = event.getMeasurements().size();

        reentrantLock.lock();

        try {
            mStrBuff = "";
            for (GnssMeasurement measurement : event.getMeasurements()) {
                if (isWriteLog) {
                    updGnssMeasStr(gnssClock, measurement);
                }
                if (++i == mMeasCnt) {
                    if (isWriteLog) {
                        mStrBuff += ",EPOCHEND\n";
                    }
                } else {
                    if (isWriteLog) {
                        mStrBuff += "\n";
                    }
                }
            }
        } finally {
            reentrantLock.unlock();
        }
    }

    @Override
    public void onGnssMeasurementsStatusChanged(int status) {
    }

    @Override
    public void onGnssNavigationMessageReceived(GnssNavigationMessage navigationMessage) {

    }

    @Override
