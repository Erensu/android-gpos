            }
        }
    }

    public void close() {
        closeRawFile();
        closePosFile();
        closeNmaFile();
        closeNLPFile();
    }

    @RequiresApi(api = VERSION_CODES.N)
    private synchronized String updGnssMeasStrClock(GnssClock clock) {
        String clockStream = String.format("Raw,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s",
                SystemClock.elapsedRealtime(),
                clock.getTimeNanos(),
                clock.hasLeapSecond() ? clock.getLeapSecond() : "",
                clock.hasTimeUncertaintyNanos() ? clock.getTimeUncertaintyNanos() : "",
                clock.getFullBiasNanos(),
                clock.hasBiasNanos() ? clock.getBiasNanos() : "",
                clock.hasBiasUncertaintyNanos() ? clock.getBiasUncertaintyNanos() : "",
                clock.hasDriftNanosPerSecond() ? clock.getDriftNanosPerSecond() : "",
                clock.hasDriftUncertaintyNanosPerSecond() ? clock.getDriftUncertaintyNanosPerSecond() : "",
                clock.getHardwareClockDiscontinuityCount() + ",");
        return clockStream;
    }

    @RequiresApi(api = VERSION_CODES.N)
    private synchronized String updGnssMeasStrMeas1(GnssClock clock, GnssMeasurement measurement) {
        String measurementStream =
                String.format("%s,%s,%s,%s,%s,%s,",
                        measurement.getSvid(),
                        measurement.getTimeOffsetNanos(),
                        measurement.getState(),
                        measurement.getReceivedSvTimeNanos(),
                        measurement.getReceivedSvTimeUncertaintyNanos(),
                        measurement.getCn0DbHz());
        return measurementStream;
    }

    @RequiresApi(api = VERSION_CODES.N)
    private synchronized String updGnssMeasStrMeas2(GnssClock clock, GnssMeasurement measurement) {

        String carrierFrequencyHz = measurement.hasCarrierFrequencyHz() ? String
                .valueOf(measurement.getCarrierFrequencyHz()) : "";
        String carrierCycles = measurement.hasCarrierCycles() ? String.valueOf(measurement.getCarrierCycles()) : "";
        String carrierPhase = measurement.hasCarrierPhase() ? String.valueOf(measurement.getCarrierPhase()) : "";
        String carrierPhaseUncertainty = measurement.hasCarrierPhaseUncertainty() ? String
                .valueOf(measurement.getCarrierPhaseUncertainty()) : "";
        String snrInDb = measurement.hasSnrInDb() ? String.valueOf(measurement.getSnrInDb()) : "";
        String automaticGainControlLevelDb =
                Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && measurement.hasAutomaticGainControlLevelDb()
                        ? String.valueOf(measurement.getAutomaticGainControlLevelDb()) : "";
        String leapSecond = clock.hasLeapSecond() ? String.valueOf(clock.getLeapSecond()) : "";

        String measurementStream =
                String.format("%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s",
                        measurement.getPseudorangeRateMetersPerSecond(),
                        measurement.getPseudorangeRateUncertaintyMetersPerSecond(),
                        measurement.getAccumulatedDeltaRangeState(),
                        measurement.getAccumulatedDeltaRangeMeters(),
                        measurement.getAccumulatedDeltaRangeUncertaintyMeters(),
                        carrierFrequencyHz,
                        carrierCycles,
                        carrierPhase,
                        carrierPhaseUncertainty,
                        measurement.getMultipathIndicator(),
                        snrInDb,
                        measurement.getConstellationType(),
                        automaticGainControlLevelDb,
                        carrierFrequencyHz,
                        leapSecond);
        return measurementStream;
    }

    @RequiresApi(api = VERSION_CODES.N)
    private synchronized String updGnssMeasStrMeas(GnssClock clock, GnssMeasurement measurement) {
        String measurementStream = "";

        measurementStream = updGnssMeasStrMeas1(clock, measurement) + updGnssMeasStrMeas2(clock, measurement);
        return measurementStream;
    }

    @RequiresApi(api = Build.VERSION_CODES.N)
    private synchronized void updGnssMeasStr(GnssClock clock, GnssMeasurement measurement) {
        String clockStream = updGnssMeasStrClock(clock);
        String measurementStream = updGnssMeasStrMeas(clock, measurement);
        String utcTimeStream = Long.toString(System.currentTimeMillis());

        double sow = getCurrSow();
        mStrBuff = clockStream + measurementStream + "," + sow + "," + utcTimeStream;
    }
    private synchronized int writeGnssMeasurementToFile(GnssClock clock, GnssMeasurement measurement)
            throws IOException {

        if (mRawOpenFile == 0) {
            return 0;
        }
        mRawFileWriter.write(mStrBuff);
        mRawFileWriter.newLine();
        mRawFileWriter.flush();
        return 1;
    }

    private void logException(String errorMessage, Exception e) {
        Log.e(TAG, errorMessage, e);
        if (TxLog.Debug) {
            TxLog.i(TAG, errorMessage);
        }
    }

    private void logError(String errorMessage) {
        Log.e(TAG, errorMessage);
        if (TxLog.Debug) {
            TxLog.i(TAG, errorMessage);
        }
    }

    private void logWarn(String warnMessage) {
        Log.w(TAG, warnMessage);
    }

    private int initLogFileContents() {
        File file = mContext.getExternalFilesDir("dgnss");

        @SuppressLint("SimpleDateFormat") SimpleDateFormat formatter = new SimpleDateFormat("yyy_MM_dd_HH_mm_ss");
        Date now = new Date();
        String fileName = String.format("%s_%s.raw", FILE_PREFIX, formatter.format(now));
        File currentFile = new File(file, fileName);
        String currentFilePath = currentFile.getAbsolutePath();
        BufferedWriter currentFileWriter;
        try {
            currentFileWriter = new BufferedWriter(new FileWriter(currentFile));
        } catch (IOException e) {
            logException("could not open file: " + currentFilePath, e);
            return 0;
        }
        if (mRawFileWriter != null) {
            try {
                mRawFileWriter.close();
            } catch (IOException e) {
                logException("unable to close all file streams.", e);
                return 0;
            }
        }
        mRawFile = currentFile;
        mRawFileWriter = currentFileWriter;
        return 1;
    }

