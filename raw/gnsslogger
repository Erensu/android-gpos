    @Override
    public void onNmeaReceived(long timestamp, String s) {
        if (mNMAFileWriter == null) {
            return;
        }
        try {
            mNMAFileWriter.write(s);
            mNMAFileWriter.newLine();
            mNMAFileWriter.flush();
        } catch (IOException e) {
            logException(ERROR_WRITING_FILE, e);
        }
    }

    @Override
