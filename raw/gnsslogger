    }

    static synchronized int getgMeasCnt() {
        return gMeasCnt;
    }

    private void closeRawFile() {
        if (mRawFile == null || mRawOpenFile == 0) {
            return;
        }
        if (mRawFileWriter != null) {
            try {
                mRawFileWriter.flush();
                mRawFileWriter.close();
                mRawFileWriter = null;
            } catch (IOException e) {
                logException("unable to close all file streams.", e);
                return;
            }
        }
    }

    private void closePosFile() {
        if (mPosFile == null || mPosOpenFile == 0) {
            return;
